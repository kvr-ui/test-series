PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/video-insights

# Optional: where the header/footer logo links to (defaults to this site's home page)
SITE_URL=

# Razorpay keys for the checkout page (Dashboard -> Account & Settings -> API Keys).
# Use rzp_test_ keys locally. Checkout shows "payments unavailable" until both are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Secret of the webhook pointing at POST /api/checkout/webhook
# (events: order.paid, payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# Optional: comma-separated origins allowed to call the API (not needed when the
# server serves the built client itself, or in dev behind the Vite proxy)
CORS_ORIGIN=

# Required for PUT /api/pages/:slug and GET /api/checkout/admin/orders. Leave empty to disable both.
ADMIN_TOKEN=
