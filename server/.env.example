PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/video-insights

# Optional: where the header/footer logo links to (defaults to this site's home page)
SITE_URL=

# Razorpay keys for the checkout page (Dashboard -> Account & Settings -> API Keys).
# Use rzp_test_ keys locally. Checkout shows "payments unavailable" until both are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Secret of the webhook pointing at POST /api/checkout/webhook
# (events: order.paid, payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# Optional: comma-separated origins allowed to call the API (not needed when the
# server serves the built client itself, or in dev behind the Vite proxy)
CORS_ORIGIN=

# Required for PUT /api/pages/:slug and GET /api/checkout/admin/orders. Leave empty to disable both.
ADMIN_TOKEN=

# Login for /dashboard (order list). Login stays disabled until ADMIN_PASSWORD is set.
ADMIN_EMAIL=kvr@focasedu.com
ADMIN_PASSWORD=
# Optional: long random string that signs dashboard sessions. If empty, everyone is logged out on restart.
# Generate one with: node -e "console.log(require(\x27crypto\x27).randomBytes(32).toString(\x27hex\x27))"
ADMIN_SESSION_SECRET=

# SMTP account for order confirmation emails (sent to the buyer once a payment is confirmed).
# Google Workspace: smtp.gmail.com, port 465, SMTP_USER = the mailbox, SMTP_PASS = an app password.
# Zoho Mail (India): smtp.zoho.in, port 465. Port 587 uses STARTTLS; SMTP_SECURE is inferred from the port.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FOCAS Edu <kvr@focasedu.com>"
# Optional: also BCC every confirmation to this address
ORDER_NOTIFY_EMAIL=
